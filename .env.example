# ---- LiveKit (required) ----
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# ---- Speech + LLM (required) ----
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
HF_TOKEN=                 # Hugging Face read token for the turn-detector model

# ---- Optional model overrides ----
# LLM_MODEL=gemini-2.5-flash
# TTS_MODEL=aura-2-thalia-en
# SUMMARY_MODEL=gemini-2.5-flash

# ---- Optional avatar (Beyond Presence). Leave blank for voice-only ----
# BEY_API_KEY=
# BEY_AVATAR_ID=

# ---- FastAPI server ----
# CORS_ORIGINS=http://localhost:3000
# CLINIC_DB_PATH=clinic.db
